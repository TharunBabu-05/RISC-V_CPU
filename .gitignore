oss-cad-suite/
oss-cad-suite-installer.exe

# Ignore environment variables and secrets
.env
*.pem
*.key

# Ignore common dependency directories


# Ignore log files and temporary files
*.log
tmp/
temp/

# Ignore build artifacts
dist/

out/

obj/

# Generated verification outputs
riscv_processor_cpu/phase5/compliance/build/
riscv_processor_cpu/formal/riscv-formal/.riscv-formal/
