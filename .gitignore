riscv_processor_cpu/phase8/vivado/vivado_project/rv32_soc_arty_s7.runs/.jobs/


# Vivado run logs are part of the kept run output


# Local editor / assistant settings
.codex/
.vscode/

# Local upstream checkouts used for the DOOM architecture study
/reference_doom/
/reference_retro_computing_2026/
/reference_doomgeneric/

